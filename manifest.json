{
  "manifest_version": 2,
  "name": "Bypass proxy (ru)",
  "version": "2.2.1",
  "description": "Российские сайты из списка geosite и ваши домены идут напрямую, остальное — через SOCKS5.",
  "author": "shutdaun",
  "homepage_url": "https://github.com/shutdaun/bypass-proxy-ru",
  "permissions": [
    "proxy",
    "storage",
    "<all_urls>"
  ],
  "browser_action": {
    "default_title": "Bypass proxy (ru)",
    "default_popup": "ui/popup.html",
    "default_icon": {
      "32": "icons/icon-32.png",
      "64": "icons/icon-64.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "scripts": [
      "lib/rules.js",
      "lib/geosite.js",
      "background.js"
    ],
    "persistent": true
  },
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  },
  "incognito": "spanning",
  "browser_specific_settings": {
    "gecko": {
      "id": "bypass-proxy-ru@shutdaun.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
